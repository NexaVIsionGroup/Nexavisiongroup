# ═══════════════════════════════════════════
# NEXAVISION GROUP — Environment Variables
# Copy to .env.local and fill in values
# ═══════════════════════════════════════════

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_READ_TOKEN=your_read_token

# Site URL
NEXT_PUBLIC_SITE_URL=https://nexavisiongroup.com

# Cron — shared secret Vercel Cron sends as a Bearer token to
# /api/admin/verify/cleanup (90-day verification-docs purge).
# Must also be set in the Vercel project env (Production).
CRON_SECRET=your_long_random_secret

# Phone Command Center backend
PHONE_API_URL=https://ai.nexavisiongroup.com/pcc
PHONE_API_TOKEN=
